# Application Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=sqlite:///./data/vector-observatory.db

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
SECRET_KEY=change-me-in-production-use-secure-random

# LLM Configuration (optional - for AI-enhanced features)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=vector-observatory
KEYCLOAK_CLIENT_ID=vector-observatory-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=vector-observatory
VITE_KEYCLOAK_CLIENT_ID=vector-observatory-client

# MCP Proxy
MCP_PROXY_ENABLED=true
MCP_PROXY_PORT=8787

# Compression Settings
DEFAULT_COMPRESSION_MODE=compress
COMPRESSION_PROFILE=full-safe